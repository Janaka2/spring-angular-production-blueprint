# Copy to .env for local development. Every value here is a DEVELOPMENT credential.
# .env is ignored by Git. Production values live in Kubernetes Secrets (reference) or a vault (enterprise).

# PostgreSQL (docker compose)
POSTGRES_DB=assetcare
POSTGRES_USER=assetcare
POSTGRES_PASSWORD=assetcare-dev-password
POSTGRES_PORT=5432

# Keycloak (docker compose). Realm "assetcare" is imported from deploy/docker/keycloak/assetcare-realm.json
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-password
KEYCLOAK_PORT=8081

# MinIO (docker compose). API on 9002 because Keycloak's management port uses 9000 on the host.
MINIO_ROOT_USER=assetcare
MINIO_ROOT_PASSWORD=assetcare-dev-password
MINIO_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=assetcare-attachments

# Backend (read by Spring Boot through application.yml placeholders)
ASSETCARE_DB_URL=jdbc:postgresql://localhost:5432/assetcare
ASSETCARE_DB_USERNAME=assetcare
ASSETCARE_DB_PASSWORD=assetcare-dev-password
ASSETCARE_OIDC_ISSUER=http://localhost:8081/realms/assetcare
ASSETCARE_CORS_ORIGINS=http://localhost:4200
ASSETCARE_STORAGE_TYPE=s3
ASSETCARE_S3_ENDPOINT=http://localhost:9002
ASSETCARE_S3_BUCKET=assetcare-attachments
ASSETCARE_S3_ACCESS_KEY=assetcare
ASSETCARE_S3_SECRET_KEY=assetcare-dev-password
